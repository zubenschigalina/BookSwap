rules_version = '2';

// BookSwap Cloud Storage security rules.
//
// Storage rules can't read Firestore, so book-image writes can't verify book ownership
// here — the books/{id} Firestore document is the real ownership gate. Profile photos
// are pinned to the caller's uid. All reads require sign-in.
service firebase.storage {
  match /b/{bucket}/o {

    // profile_photos/{uid}.jpg — only the owning user may write their own photo.
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // book_images/{bookId}/{index}.jpg — any signed-in user may upload (ownership is
    // enforced on the Firestore book doc); everyone signed in may view.
    match /book_images/{bookId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // chat_images/{proposalId}/{messageId}.jpg — image attachments in an exchange chat
    // (Epic 9). Same limitation as above: participation is enforced on the Firestore
    // message document, which is the only thing that surfaces the URL.
    match /chat_images/{proposalId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
